NEXT_PUBLIC_SITE_URL=https://meda.app

# Capa de IA (opcional). Sin clave, MeDa funciona igual con la explicación determinista.
NEXT_PUBLIC_AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google AdSense: ID de editor (ca-pub-…). Vacío = sin anuncios.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Afiliación (ver docs/AFILIACION.md). Vacío = enlace directo sin comisión.
NEXT_PUBLIC_AMAZON_TAG=
# Plantillas con {url} (destino codificado) o {raw}. Ej. Awin:
# https://www.awin1.com/cread.php?awinmid=MID&awinaffid=TU_ID&ued={url}
NEXT_PUBLIC_AFF_IAHORRO=
NEXT_PUBLIC_AFF_HELPMYCASH=
NEXT_PUBLIC_AFF_RASTREATOR=
NEXT_PUBLIC_AFF_ACIERTO=
NEXT_PUBLIC_AFF_COCHESNET=
NEXT_PUBLIC_AFF_AUTOSCOUT24=
NEXT_PUBLIC_AFF_FOTOCASA=
NEXT_PUBLIC_AFF_BOOKING=
NEXT_PUBLIC_AFF_SKYSCANNER=
# Viajes: casi todos salen de un solo alta en Travelpayouts.
NEXT_PUBLIC_AFF_CIVITATIS=
NEXT_PUBLIC_AFF_GETYOURGUIDE=
NEXT_PUBLIC_AFF_TIQETS=
NEXT_PUBLIC_AFF_HOSTELWORLD=
NEXT_PUBLIC_AFF_WELCOMEPICKUPS=
NEXT_PUBLIC_AFF_AIRALO=

# Precios reales de vuelo (Aviasales Data API). SIN prefijo público: son de servidor.
# Sin token, el planificador estima el vuelo por distancia y no se rompe nada.
TRAVELPAYOUTS_TOKEN=
# Partner ID: hace que el enlace al vuelo pague comisión.
TRAVELPAYOUTS_MARKER=

# Aviso legal (LSSI)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=hola@meda.app

# PostHog (opcional): eventos y experimentos A/B sin cookies. Ver docs/EXPERIMENTOS.md.
# Clave de proyecto (phc_…), es pública. Host de la UE por defecto.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
